# Variable NAMES only. Values are intentionally empty so a host that imports this file
# (Railway "suggested variables") never picks up fake placeholder numbers or URLs.
# web = browser page as the callee (no Twilio needed), twilio = real phone calls.
# Empty: Twilio when fully configured, else web if OPENAI_API_KEY and PUBLIC_BASE_URL are set.
HERMES_PHONE_MODE=
# Twilio account SID, starts with AC (Twilio mode only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number, E.164, e.g. +1XXXXXXXXXX
TWILIO_FROM_NUMBER=
OPENAI_API_KEY=
# https://<your public domain>, no trailing slash
PUBLIC_BASE_URL=
# Comma-separated E.164 numbers that may be dialed. Empty = all dialing refused.
HERMES_PHONE_TEST_ALLOWLIST=
HERMES_PHONE_BRIDGE_PORT=
HERMES_PHONE_DB_PATH=
# Realtime voice model and voice (optional)
HERMES_PHONE_MODEL=
HERMES_PHONE_VOICE=
